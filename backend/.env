# Local development example. Copy to backend/.env (never commit or distribute backend/.env).
# Required: generate a unique secret before starting:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=9wwSBxZUloj3HRJpcEfDJYNkaIv6hW8wG9ulNk98M76V6RXdqVLSLfqJ9kCOwEav

DATABASE_URL=sqlite:///./data/edunexus.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Local demonstrations only: set both to true to create the documented demo accounts.
# Never enable SEED_DEMO_ACCOUNTS for a shared or public deployment.
SEED_ON_START=false
SEED_DEMO_ACCOUNTS=false

# For a real first run, set both values once. The administrator is created only when the
# database has no users. Change the password after signing in and remove these values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Domain used to generate a unique institutional email at approval (for example,
# students.yourinstitution.edu). The example placeholder must be replaced for production.
INSTITUTION_EMAIL_DOMAIN=edunexus.in

# Public frontend URL used in credential and account emails (for example,
# http://127.0.0.1:5174). Credential delivery is reported as CONFIGURATION_ERROR
# until both this value and SMTP are configured. No URL is invented.
APP_URL=http://127.0.0.1:5174

# Optional SMTP delivery. Persistent in-app notifications work without these values.
# Configure all required values to enable email and keep the password secret.
# Restart the API after changing SMTP, APP_URL, or INSTITUTION_EMAIL_DOMAIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
SMTP_USE_TLS=true

# Optional synthetic academic pilot seed (development only). The seed is additive/idempotent.
# Set a strong temporary password before running backend/scripts/seed_academic_pilot.py.
ACADEMIC_DEMO_PASSWORD=

# Optional Google Gemini configuration. With no key, the interactive tutor and Socratic
# answer boxes stay disabled; the API can still return extractive draft quotes.
# Create and rotate the key in Google AI Studio; never place it in frontend code.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

APP_ENV=development
